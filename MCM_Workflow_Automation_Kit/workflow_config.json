{
  "project_pipeline_command": [
    "conda",
    "--no-plugins",
    "run",
    "-n",
    "mcm",
    "python",
    "scripts/run_all.py"
  ],
  "raw_data_files": [
    "data/raw/2026_MCM_Problem_C_Data.csv"
  ],
  "data_source_manifest": "reports/data_source_manifest.csv",
  "external_data_needs": "reports/external_data_needs.md",
  "external_data_dir": "data/raw/external",
  "external_data_required": false,
  "source_manifest_required": true,
  "paper_tex": "paper/main.tex",
  "paper_pdf": "paper/main.pdf",
  "latex_log": "paper/main.log",
  "key_results": "reports/key_results.csv",
  "figure_manifest": "reports/figure_manifest.csv",
  "figures_dirs": [
    "figures/concept",
    "figures/generated"
  ],
  "tables_dir": "tables",
  "workflow_reports_dir": "reports/workflow",
  "page_target": 25,
  "page_hard_limit": 26,
  "placeholder_patterns": [
    "TODO",
    "TBD",
    "placeholder",
    "need calculate"
  ],
  "team_control_number_placeholders": [
    "1111111"
  ],
  "diagram_sources": [
    {
      "figure_id": "Fig. 1",
      "png": "figures/concept/fig_1_overall_research_workflow.png",
      "svg": "figures/concept_src/fig_1_overall_research_workflow.svg",
      "json": "figures/concept_src/fig_1_overall_research_workflow.json",
      "expected_source": "scripts/render_workflow_figure.py",
      "min_width": 1600,
      "min_height": 700
    }
  ],
  "release_artifacts": [
    "paper/main.pdf",
    "paper/main.tex",
    "reports",
    "figures",
    "tables",
    "data/processed",
    "environment.yml",
    "requirements-lock.txt"
  ]
}
